      "expected_groups": [["supplier_name", "supplier_tax_id"], ["buyer_name", "buyer_address"]]
    },
    {
      "name": "claim_three_parties",
      "class": "multi_party",
      "domain": "insurance",
      "columns": ["claim_id", "insurer_name", "insurer_code", "provider_name", "provider_npi", "patient_name", "patient_dob"],
      "expected_parties": 3,
      "expected_groups": [["insurer_name", "insurer_code"], ["provider_name", "provider_npi"], ["patient_name", "patient_dob"]]
    },
    {
      "name": "shipment_shipper_consignee",
      "class": "multi_party",
      "columns": ["waybill_id", "shipper_name", "shipper_address", "consignee_name", "consignee_address"],
      "expected_parties": 2,
      "expected_groups": [["shipper_name", "shipper_address"], ["consignee_name", "consignee_address"]]
    },
    {
      "name": "order_customer_and_seller",
      "class": "multi_party",
      "columns": ["order_id", "customer_name", "customer_email", "seller_name", "seller_rating"],
      "expected_parties": 2,
      "expected_groups": [["customer_name", "customer_email"], ["seller_name", "seller_rating"]]
    },
    {
      "name": "employment_employee_manager",
      "class": "multi_party",
      "columns": ["employee_id", "employee_name", "manager_id", "manager_name", "department"],
      "expected_parties": 2,
      "expected_groups": [["employee_id", "employee_name"], ["manager_id", "manager_name"]]
    },
    {
      "name": "single_party_control",
      "class": "single_party",
      "note": "The common case. One party is the RIGHT answer, not a degenerate one.",
      "columns": ["customer_id", "customer_name", "customer_email", "customer_city"],
      "expected_parties": 1,
      "expected_groups": [["customer_id", "customer_name", "customer_email", "customer_city"]]
    }
  ]
}
